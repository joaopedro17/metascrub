pkgbase = metascrub-bin
	pkgdesc = Remove hidden metadata from photos, videos, audio, documents and archives
	pkgver = {{version}}
	pkgrel = 1
	url = https://github.com/joaopedro17/metascrub
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	provides = metascrub
	conflicts = metascrub
	options = !strip
	options = !debug
	source_x86_64 = https://github.com/joaopedro17/metascrub/releases/download/v{{version}}/metascrub-v{{version}}-x86_64-unknown-linux-musl.tar.gz
	sha256sums_x86_64 = {{sha256 x86_64-unknown-linux-musl}}
	source_aarch64 = https://github.com/joaopedro17/metascrub/releases/download/v{{version}}/metascrub-v{{version}}-aarch64-unknown-linux-musl.tar.gz
	sha256sums_aarch64 = {{sha256 aarch64-unknown-linux-musl}}

pkgname = metascrub-bin

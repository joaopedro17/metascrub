# AUR package metascrub-bin: the release binaries.
# Filled in by `just manifests <version>`, with .SRCINFO next to it.
pkgname=metascrub-bin
pkgver={{version}}
pkgrel=1
pkgdesc="Remove hidden metadata from photos, videos, audio, documents and archives"
arch=('x86_64' 'aarch64')
url="https://github.com/joaopedro17/metascrub"
license=('MIT OR Apache-2.0')
provides=('metascrub')
conflicts=('metascrub')
options=('!strip' '!debug')
source_x86_64=("https://github.com/joaopedro17/metascrub/releases/download/v$pkgver/metascrub-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/joaopedro17/metascrub/releases/download/v$pkgver/metascrub-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('{{sha256 x86_64-unknown-linux-musl}}')
sha256sums_aarch64=('{{sha256 aarch64-unknown-linux-musl}}')

package() {
  cd "metascrub-v$pkgver-$CARCH-unknown-linux-musl"
  install -Dm755 metascrub "$pkgdir/usr/bin/metascrub"
  install -Dm644 -t "$pkgdir/usr/share/man/man1" man/*.1
  install -Dm644 completions/metascrub.bash "$pkgdir/usr/share/bash-completion/completions/metascrub"
  install -Dm644 completions/_metascrub "$pkgdir/usr/share/zsh/site-functions/_metascrub"
  install -Dm644 completions/metascrub.fish "$pkgdir/usr/share/fish/vendor_completions.d/metascrub.fish"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE-MIT LICENSE-APACHE THIRD-PARTY-LICENSES.md
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGELOG.md
}
